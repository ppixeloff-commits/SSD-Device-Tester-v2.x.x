<UserControl x:Class="SSHTester.DeviceTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f8fafc" FontFamily="Segoe UI" FontSize="13">
    
    <UserControl.Resources>
        <!-- Moderní minimalistický styl pro Expander sekce -->
        <Style TargetType="Expander">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1e293b"/>
        </Style>
        <Style TargetType="Border" x:Key="ExpanderContentBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Horní stavový panel zařízení -->
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSaveProfile" Content="Save Profile" Width="90" Height="28" Margin="0,0,6,0" Background="#64748b" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnLoadProfile" Content="Load Profile" Width="90" Height="28" Background="#64748b" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSucc" Text="SUCCESS: 0" Foreground="#10b981" FontWeight="Bold" FontSize="13" Margin="8,0"/>
                    <TextBlock x:Name="TxtFail" Text="FAIL: 0" Foreground="#ef4444" FontWeight="Bold" FontSize="13" Margin="8,0"/>
                    <TextBlock x:Name="TxtTotal" Text="TOTAL: 0" Foreground="#3b82f6" FontWeight="Bold" FontSize="13" Margin="8,0"/>
                    <TextBlock x:Name="TxtAvgTime" Text="AVG TIME: 00:00:00" Foreground="#64748b" FontWeight="SemiBold" FontSize="13" Margin="8,0"/>
                    <TextBlock x:Name="TxtDevStatus" Text="DEV: Unknown" Foreground="#3b82f6" FontWeight="Bold" FontSize="13" Margin="8,0"/>
                    <TextBlock x:Name="TxtRelayStatusTxt" Text="RELAY: ON" Foreground="#f59e0b" FontWeight="Bold" FontSize="13" Margin="8,0,15,0"/>
                    <Canvas x:Name="PieChartCanvas" Width="36" Height="36" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Konfigurace a parametry -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Konfigurace -->
                <Expander Header="Configuration" IsExpanded="True">
                    <Border Style="{StaticResource ExpanderContentBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="IP Address:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,8" FontWeight="Normal"/>
                            <TextBox x:Name="TxtIpAddress" Grid.Row="0" Grid.Column="1" Margin="0,0,15,8" Height="26" VerticalContentAlignment="Center" BorderBrush="#cbd5e1"/>

                            <TextBlock Text="SSH User:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,8" FontWeight="Normal"/>
                            <TextBox x:Name="TxtUser" Text="root" Grid.Row="0" Grid.Column="3" Margin="0,0,15,8" Height="26" VerticalContentAlignment="Center" BorderBrush="#cbd5e1"/>

                            <TextBlock Text="SSH Pass:" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,6,8" FontWeight="Normal"/>
                            <Grid Grid.Row="0" Grid.Column="5" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="TxtPassword" Grid.Column="0" Height="26" VerticalContentAlignment="Center"/>
                                <TextBox x:Name="TxtPasswordVisible" Grid.Column="0" Visibility="Collapsed" Height="26" VerticalContentAlignment="Center"/>
                                <CheckBox x:Name="ChkShowPass" Content="👁" Grid.Column="1" Margin="6,0,15,0" VerticalAlignment="Center" Click="ChkShowPass_Click" FontWeight="Normal"/>
                                
                                <TextBlock Text="SSH Key:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtSshKey" Grid.Column="3" Height="26" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnBrowseKey" Content="..." Grid.Column="4" Width="26" Height="26" Margin="4,0,0,0" Click="BtnBrowseKey_Click" Background="#cbd5e1" Foreground="#334155" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <TextBlock Text="Cycles(0=inf):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                            <TextBox x:Name="TxtCycles" Text="0" Grid.Row="1" Grid.Column="1" Margin="0,0,15,0" Height="26" VerticalContentAlignment="Center" BorderBrush="#cbd5e1"/>

                            <TextBlock Text="Timeout(s):" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                            <TextBox x:Name="TxtTimeout" Text="60" Grid.Row="1" Grid.Column="3" Margin="0,0,15,0" Height="26" VerticalContentAlignment="Center" BorderBrush="#cbd5e1"/>

                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" VerticalAlignment="Center">
                                <TextBlock Text="Wait On/Off:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtWaitOn" Text="10" Width="35" Height="26" VerticalContentAlignment="Center"/>
                                <TextBlock Text=" / " VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox x:Name="TxtWaitOff" Text="3" Width="35" Height="26" Margin="0,0,15,0" VerticalContentAlignment="Center"/>
                                
                                <TextBlock Text="Ping Cnt/Int:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtPingCnt" Text="5" Width="35" Height="26" VerticalContentAlignment="Center"/>
                                <TextBlock Text=" / " VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox x:Name="TxtPingInt" Text="1.0" Width="35" Height="26" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

                <!-- Relé -->
                <Expander Header="Relay Power Cycle (Arion COM Port)" IsExpanded="True">
                    <Border Style="{StaticResource ExpanderContentBorder}">
                        <StackPanel>
                            <CheckBox x:Name="ChkRelayEnable" Content="Enable Relay Power Cycle at the end of each cycle" FontWeight="Normal" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <TextBlock Text="COM Port:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtRelayPort" Text="COM3" Width="60" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="Baudrate:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtRelayBaud" Text="38400" Width="60" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtRelayAddr" Text="1" Width="35" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="Relays(0,1):" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtRelayMask" Text="1" Width="35" Height="26" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <TextBlock Text="OFF (ms):" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtRelayOff" Text="10000" Width="60" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="ON (ms):" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <TextBox x:Name="TxtRelayOn" Text="1000" Width="60" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="Manual:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Normal"/>
                                <Button x:Name="BtnRelayOn" Content="ON" Width="45" Height="26" Background="#3b82f6" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button x:Name="BtnRelayOff" Content="OFF" Width="45" Height="26" Background="#ef4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button x:Name="BtnRelayCycle" Content="Cycle" Width="55" Height="26" Background="#f59e0b" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox x:Name="ChkRelayAutoRecover" Content="Auto-recover (restart) if offline for:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtAutoRecoverSec" Text="300" Width="40" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="s" VerticalAlignment="Center" FontWeight="Normal"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Typ Testu -->
                <Expander Header="Test Type" IsExpanded="True">
                    <Border Style="{StaticResource ExpanderContentBorder}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbModem" GroupName="TestType" Content="Modem Test" Checked="ToggleParams" Margin="0,0,20,0"/>
                            <RadioButton x:Name="RbSsd1Gb" GroupName="TestType" Content="SSD 1GB Test" Checked="ToggleParams" Margin="0,0,20,0"/>
                            <RadioButton x:Name="RbSsdStress" GroupName="TestType" Content="SSD Stress Test" IsChecked="True" Checked="ToggleParams" Margin="0,0,20,0"/>
                            <RadioButton x:Name="RbFsck" GroupName="TestType" Content="FSCK Drive Test" Checked="ToggleParams" Margin="0,0,20,0"/>
                            <RadioButton x:Name="RbCustom" GroupName="TestType" Content="Custom Test" Checked="ToggleParams"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Parametry Testu -->
                <Expander Header="Test Parameters" IsExpanded="True">
                    <Border Style="{StaticResource ExpanderContentBorder}">
                        <Grid>
                            <StackPanel x:Name="PanelStress" Visibility="Visible">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mount Device (opt):" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox x:Name="TxtStressMount" Text="/dev/sdb" Grid.Column="1" Height="26" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Directory:" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox x:Name="TxtStressDir" Text="/mnt" Grid.Column="1" Height="26" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Grid x:Name="PanelStressSize">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Disk Size (GB):" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox x:Name="TxtStressSize" Text="3.8" Grid.Column="1" Width="100" Height="26" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelModem" Visibility="Collapsed">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Expected IMEIs (csv):" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox x:Name="TxtModemImei" Grid.Column="1" Height="26" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Or count:" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox x:Name="TxtModemCount" Grid.Column="1" Width="100" Height="26" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelCustom" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Commands File (.txt):" VerticalAlignment="Center" FontWeight="Normal"/>
                                    <TextBox x:Name="TxtCustomFile" Grid.Column="1" Height="26" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnBrowse" Content="..." Grid.Column="2" Width="30" Height="26" Margin="6,0,0,0" Background="#cbd5e1" Foreground="#334155" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

                <!-- Hlavní akční tlačítka -->
                <Grid Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Button x:Name="BtnStart" Content="Start Test" Width="100" Height="32" Background="#10b981" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Content="Pause" Width="80" Height="32" Background="#f59e0b" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button x:Name="BtnStop" Content="Stop Test" Width="100" Height="32" Background="#ef4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Content="Apply Changes" Width="120" Height="32" Background="#94a3b8" Foreground="White" FontWeight="Bold" BorderThickness="0" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="2">
                        <Button x:Name="BtnClearLog" Content="Clear Log" Width="90" Height="32" Background="#64748b" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                        <Button x:Name="BtnExportCsv" Content="Export CSV" Width="90" Height="32" Background="#3b82f6" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                        <Button x:Name="BtnExportLog" Content="Export Log" Width="90" Height="32" Background="#3b82f6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Console Output" FontWeight="Bold" Foreground="#475569" Margin="0,6,0,4"/>
                <TextBox x:Name="TxtConsole" Background="#0f172a" Foreground="#38bdf8" FontFamily="Consolas" FontSize="12" Height="320" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="1" BorderBrush="#cbd5e1"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Spodní StatusBar -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Text="Ready..." FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#64748b"/>
            <ProgressBar x:Name="PbStatus" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#3b82f6" Background="#e2e8f0" BorderThickness="0"/>
        </Grid>
    </Grid>
</UserControl>