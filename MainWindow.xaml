<Window x:Class="SSHTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SSHTester"
        Title="SSH Device Tester - Multi-Device" Height="800" Width="1200" Background="#f8fafc"
        FontFamily="Segoe UI" FontSize="13">
    
    <Window.Resources>
        <local:IntToVisConverter x:Key="IntToVisConverter" />
        <local:BoolToPauseTextConverter x:Key="BoolToPauseTextConverter" />

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#e2e8f0" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#f1f5f9"/>
                                <Setter Property="Foreground" Value="#334155"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#ffffff"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#e2e8f0"/>
                                <Setter Property="Foreground" Value="#0f172a"/>
                                <Setter TargetName="TabBorder" Property="Margin" Value="0,0,4,-1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceTileCard" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#94a3b8"/>
                    <Setter Property="Background" Value="#f8fafc"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Margin="10,47,10,0" VerticalAlignment="Top"/>

        <TabControl x:Name="MainTabControl" Margin="10,10,10,10" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
            
            <TabItem Header="Global Dashboard" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,15,0,0">
                    <StackPanel MaxWidth="1400" HorizontalAlignment="Left" Margin="10,0">
                        
                        <Grid Margin="5,0,5,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,35,0">
                                    <TextBlock Text="TOTAL DEVICES" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TotalDevices}" Foreground="#0f172a" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,35,0">
                                    <TextBlock Text="ONLINE" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OnlineDevices}" Foreground="#10b981" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="SUCCESS RATE" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding GlobalSuccessRate}" Foreground="#3b82f6" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Přidán Margin 0,0,30,0 na celý tento StackPanel, aby oddělil ComboBox od tlačítek -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="35,0,30,0">
                                <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBox}" Width="220" TextChanged="FilterChanged" Margin="0,0,10,0" ToolTip="Search by IP or Name..."/>
                                <ComboBox x:Name="CmbFilter" Width="140" SelectionChanged="FilterChanged" Padding="10,6" BorderBrush="#cbd5e1" Background="#ffffff" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="All Devices" IsSelected="True"/>
                                    <ComboBoxItem Content="Online"/>
                                    <ComboBoxItem Content="Offline"/>
                                    <ComboBoxItem Content="Failing"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Jednotné odsazení (Margin="0,0,10,0") pro všechna tlačítka -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Start All" Style="{StaticResource ModernButton}" Background="#10b981" Margin="0,0,10,0" Click="BtnStartAll_Click"/>
                                <Button Content="Stop All" Style="{StaticResource ModernButton}" Background="#ef4444" Margin="0,0,10,0" Click="BtnStopAll_Click"/>
                                <Button Content="Import CSV" Style="{StaticResource ModernButton}" Background="#64748b" Margin="0,0,10,0" Click="BtnImport_Click"/>
                                <Button Content="Export All" Style="{StaticResource ModernButton}" Background="#3b82f6" Click="BtnExportAll_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#fef2f2" BorderBrush="#fecaca" BorderThickness="1" CornerRadius="8" Padding="15" Margin="5,0,5,20"
                                Visibility="{Binding GlobalWarnings.Count, Converter={StaticResource IntToVisConverter}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="System Warnings" FontWeight="Bold" Foreground="#dc2626" FontSize="14" Margin="0,0,0,8"/>
                                    <Button Content="Clear" HorizontalAlignment="Right" Background="Transparent" Foreground="#dc2626" BorderThickness="0" Cursor="Hand" Click="BtnClearWarnings_Click"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding GlobalWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#991b1b" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="DeviceItemsControl" ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DeviceTileCard}" Width="310" MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBox Text="{Binding TabName, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontWeight="Bold" FontSize="16" Foreground="#0f172a" 
                                                         Background="Transparent" BorderThickness="0" 
                                                         Padding="0" ToolTip="Edit device name"
                                                         MouseLeftButtonUp="TileNameBox_MouseLeftButtonUp"/>
                                                
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding DevStateColor}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DevState}" Foreground="#64748b" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="IP: " Foreground="#94a3b8" FontSize="13"/>
                                                    <TextBlock Text="{Binding IpAddress}" Foreground="#475569" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Status}" Foreground="#64748b" FontSize="13" TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Grid Grid.Row="3" Margin="0,15,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="36" Height="36">
                                                    <Ellipse Stroke="{Binding ChartFailColor}" StrokeThickness="6" Width="28" Height="28" />
                                                    <Ellipse Stroke="{Binding ChartSuccessColor}" StrokeThickness="6" Width="28" Height="28"
                                                             StrokeDashArray="{Binding SuccessDashArray}" RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding Cycles}" VerticalAlignment="Center" Margin="12,0,0,0" 
                                                           FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>

                                                <Button Grid.Column="2" 
                                                        Content="{Binding IsPaused, Converter={StaticResource BoolToPauseTextConverter}, FallbackValue='Pause'}" 
                                                        Style="{StaticResource ModernButton}" 
                                                        Background="#e2e8f0" Foreground="#334155" 
                                                        Padding="12,6" FontSize="12" Click="TilePause_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <TabItem x:Name="AddTabButton" ToolTip="Přidat nové zařízení">
                <TabItem.Header>
                    <TextBlock Text="+" FontSize="20" FontWeight="Bold" Margin="0,-4,0,0" Foreground="#3b82f6"/>
                </TabItem.Header>
            </TabItem>

        </TabControl>
    </Grid>
</Window>