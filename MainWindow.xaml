<Window x:Class="SSHTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Device Tester - Multi-Device" Height="800" Width="1200" Background="#f8fafc"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Horní ovládací panel -->
        <StackPanel Orientation="Horizontal" Background="#ffffff" Margin="10,10,10,5">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#f1f5f9"/>
                    <Setter Property="Foreground" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </StackPanel.Resources>
            <Button Content="+ New Device" Click="AddDevice_Click"/>
            <Button Content="- Close Current Tab" Click="CloseTab_Click"/>
        </StackPanel>

        <!-- Hlavní záložky a Dashboard -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="10,0,10,10" Background="Transparent" BorderThickness="0">
            <TabItem Header="Global Dashboard" FontWeight="SemiBold" Padding="15,8">
                <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Margin="0,5,0,0">
                    <DataGrid x:Name="DashboardGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                              Background="Transparent" RowHeight="45" AlternatingRowBackground="#f8fafc" 
                              HorizontalGridLinesBrush="#f1f5f9" VerticalGridLinesBrush="Transparent" BorderThickness="0" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tab" Binding="{Binding TabName}" Width="100" FontWeight="Bold"/>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="150"/>
                            <DataGridTemplateColumn Header="Dev State" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DevState}" Foreground="{Binding DevStateColor}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Cycles" Binding="{Binding Cycles}" Width="150" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="Chart" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="16" Height="16" Fill="{Binding ChartColor}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>